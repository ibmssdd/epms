    &quot;lecture_date&quot; TEXT NOT NULL,
    &quot;subject_code&quot; TEXT NOT NULL,
    &quot;chapter_code&quot; TEXT NOT NULL,
    &quot;topic_code&quot; TEXT NOT NULL,
    &quot;lecture_seq_no&quot; INTEGER NOT NULL,

    &quot;lecture_id&quot; TEXT UNIQUE GENERATED ALWAYS AS (
        &quot;lecture_date&quot; || '-' ||
        &quot;subject_code&quot; || '-' ||
        &quot;chapter_code&quot; || '-' ||
        &quot;topic_code&quot; || '-Lec' ||
        &quot;lecture_seq_no&quot;
    ) STORED,

    &quot;lecture_type_code&quot; TEXT NOT NULL DEFAULT 'CC-XC',
    &quot;lecture_short_details&quot; TEXT,

    &quot;lecture_class_notes_file_path&quot; TEXT,
    &quot;lecture_class_notes_images&quot; TEXT,

    &quot;lecture_voice_note_file_path&quot; TEXT,
    &quot;lecture_voice_note_duration&quot; INTEGER,
    &quot;lecture_voice_note_created_at&quot; TEXT,

    &quot;lecture_task_created&quot; INTEGER NOT NULL DEFAULT 0,
    &quot;created_at&quot; TEXT NOT NULL,

    PRIMARY KEY (
        &quot;lecture_date&quot;,
        &quot;subject_code&quot;,
        &quot;chapter_code&quot;,
        &quot;topic_code&quot;,
        &quot;lecture_seq_no&quot;
    ),

    FOREIGN KEY (
        &quot;subject_code&quot;,
        &quot;chapter_code&quot;,
        &quot;topic_code&quot;
    ) REFERENCES &quot;db_SyllabusMaster&quot; (
        &quot;subject_code&quot;,
        &quot;chapter_code&quot;,
        &quot;topic_code&quot;
    ),

    CHECK(length(trim(&quot;lecture_date&quot;)) &gt; 0),
    CHECK(length(trim(&quot;subject_code&quot;)) &gt; 0),
    CHECK(length(trim(&quot;chapter_code&quot;)) &gt; 0),
    CHECK(length(trim(&quot;topic_code&quot;)) &gt; 0),
    CHECK(&quot;lecture_seq_no&quot; &gt; 0)
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
